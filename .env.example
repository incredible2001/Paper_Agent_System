# ============================================================
# Paper Agent System - 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的真实 API Key
# 命令: cp .env.example .env
#
# 系统会根据 input/llm_config.yaml 中配置的 provider
# 自动调用对应的 API Key
# ============================================================

# ============================================================
# MiMo API (默认)
# ============================================================
MIMO_API_KEY=your-mimo-api-key-here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# MIMO_MODEL=mimo-v2.5-pro  # 已弃用，现在通过配置文件设置

# ============================================================
# OpenAI API
# ============================================================
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=  # 留空使用默认，或填入自定义地址

# ============================================================
# Anthropic API
# ============================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=  # 留空使用默认，或填入自定义地址

# ============================================================
# PubMed API (可选)
# ============================================================
# PUBMED_EMAIL=your@email.com  # 在 config.yaml 中配置
# PUBMED_API_KEY=  # 可选，提高速率限制

# ============================================================
# 使用示例
# ============================================================
#
# 示例1: 只使用 MiMo
# MIMO_API_KEY=sk-xxxxx
# 其他留空
#
# 示例2: 只使用 OpenAI
# OPENAI_API_KEY=sk-xxxxx
# 其他留空
#
# 示例3: 混合使用
# MIMO_API_KEY=sk-mimo-xxxxx
# OPENAI_API_KEY=sk-openai-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx
#
# ============================================================
